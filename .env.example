# Secrets only. Copy to .env (never committed). Other settings live in config.yaml;
# any of them can also be overridden here, e.g. LLM_PROVIDER=openai or CHUNK_SIZE=500.

GEMINI_API_KEY=
OPENAI_API_KEY=

# Access tokens, as {"<sha256 hex of token>": "<user_id>"}. Empty rejects every request.
# Make one: python -c "import hashlib,secrets;t=secrets.token_urlsafe(32);print(t, hashlib.sha256(t.encode()).hexdigest())"
# Give the user the token; put only the hash here.
AUTH_TOKENS={}

# Extra regexes to redact, as a JSON list, e.g. ["EMP-\d{6}"]
SECRET_PATTERNS=[]
