BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_NAME=RAG Chatbot API

# LLM provider: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MIN_SIMILARITY_SCORE=0.05

# Largest accepted upload
MAX_UPLOAD_MB=20

# Credential redaction (extra patterns: JSON list of regexes)
REDACT_SECRETS=true
SECRET_PATTERNS=[]

# Access tokens, as {"<sha256 hex of token>": "<user_id>"}. Empty rejects every request.
# Make one: python -c "import hashlib,secrets;t=secrets.token_urlsafe(32);print(t, hashlib.sha256(t.encode()).hexdigest())"
# Give the user the token; put only the hash here.
AUTH_TOKENS={}
