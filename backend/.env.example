BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_NAME=RAG Chatbot API

# LLM provider: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MIN_SIMILARITY_SCORE=0.05
